{
  "storm-mdp": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %mdp --prop '%property-finite-horizon; %property'",
    "input-files": [
      "%mdp"
    ],
    "output-files": [],
    "description": "The (non-interval) MDP. No bisimulation quotienting."
  },
  "storm-mdpbisim": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %mdp --bisimulation --bisimulation:tolerance 0 --bisimulation:exportquotient %name.mdpquot.tar.gz --prop '%property-finite-horizon; %property'",
    "input-files": [
      "%mdp"
    ],
    "output-files": [
      "%name.mdpquot.tar.gz"
    ],
    "description": "The (non-interval) MDP. Apply (exact) bisimulation quotienting."
  },
  "storm-imdp": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %imdp --uncertainty-resolution robust --prop '%property-finite-horizon; %property'",
    "input-files": [
      "%imdp"
    ],
    "output-files": [],
    "description": "The IMDP with learned interval probabilities. No bisimulation quotienting."
  },
  "storm-imdpbisim": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %imdp --bisimulation --bisimulation:tolerance 0 --bisimulation:exportquotient %name.imdpquot.tar.gz --uncertainty-resolution robust --prop '%property-finite-horizon; %property'",
    "input-files": [
      "%imdp"
    ],
    "output-files": [
      "%name.imdpquot.tar.gz"
    ],
    "description": "The IMDP with learned interval probabilities. Apply (exact) bisimulation quotienting."
  },
  "storm-imdpapproxbisim1": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %imdp --bisimulation --bisimulation:tolerance 0.01 --bisimulation:exportquotient %name.imdpquot1.tar.gz --uncertainty-resolution robust --prop '%property-finite-horizon; %property'",
