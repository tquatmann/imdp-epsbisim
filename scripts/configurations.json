  "storm-imdpapproxbisim4": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %imdp --bisimulation --bisimulation:tolerance 0.2 --bisimulation:exportquotient %name.imdpquot4.tar.gz --uncertainty-resolution robust --prop '%property-finite-horizon; %property'",
