{
  "storm-mdp": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %mdp --prop '%property-finite-horizon; %property'",
    "input-files": [
      "%mdp"
    ],
    "output-files": [],
    "description": "The (non-interval) MDP. No bisimulation quotienting."
  },
  "storm-mdpbisim": {
    "bin": "bin/storm",
    "cmd": "--explicit-umb %mdp --bisimulation --bisimulation:tolerance 0 --bisimulation:exportquotient %name.mdpquot.tar.gz --prop '%property-finite-horizon; %property'",
    "input-files": [
      "%mdp"
    ],
    "output-files": [
      "%name.mdpquot.tar.gz"
    ],
    "description": "The (non-interval) MDP. Apply (exact) bisimulation quotienting."
  },
  "storm-imdpa": {
