    ],
    "output-files": [
      "%name.imdpquot1.tar.gz"
    ],
    "description": "The IMDP with learned interval probabilities. Apply approximate bisimulation quotienting with tolerance 0.01."
  },
  "storm-imdpapproxbisim2": {
